{
  "name": "jin-gui",
  "version": "1.1.0",
  "license": "AGPL-3.0-only",
  "description": "Jin GUI — Tauri 2.x consumer of jin-core",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build && node tools/gui-build-fingerprint.mjs",
    "icons:generate": "bash tools/generate-app-icons.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "test:production-due": "node tools/production-due-smoke.mjs",
    "test:notes-writing-surface": "node tools/gui-build-fingerprint.mjs --verify && node tools/notes-writing-surface-smoke.mjs",
    "visual:candidates": "npm run visual:compare",
    "visual:compare": "node tools/visual-command.mjs --compare",
    "visual:record": "node tools/visual-command.mjs --record",
    "visual:selftest": "node tools/visual-command.mjs --selftest",
    "tauri": "tauri",
    "lint:css": "stylelint 'src/styles/**/*.css'",
    "screenshots": "vite build && node tools/screenshot.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@fontsource/inter": "^5.1.1",
    "@hotwired/stimulus": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "lucide": "^0.523.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.1",
    "stylelint": "^16.20.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
