{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "jin",
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "bump-minor-pre-major": false,
      "extra-files": [
        { "type": "toml", "path": "jin/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "jin-core/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "jin-gui/src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'jin')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'jin-core')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'jin-gui')].version" },
        { "type": "json", "path": "jin-gui/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "jin-gui/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "jin-gui/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "jin-gui/src-tauri/tauri.conf.json", "jsonpath": "$.version" }
      ]
    }
  }
}
