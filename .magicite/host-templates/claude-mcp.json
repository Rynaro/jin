{
  "mcpServers": {
    "magicite": {
      "command": "/absolute/path/to/magicite/venv-1.0.0/bin/magicite",
      "args": [
        "serve",
        "--project-root",
        "/absolute/path/to/jin"
      ],
      "env": {
        "MAGICITE_EMBEDDING_OFFLINE": "1",
        "FASTEMBED_CACHE_PATH": "/absolute/path/to/magicite/model-cache"
      }
    }
  }
}
