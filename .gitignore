# Owner-local tool configuration and generated harness state. These are never
# part of a public snapshot; portable project instructions remain tracked.
.codex/config.toml
.mcp.json
eidolons.mcp.lock
.eidolons/harness/manifest.json

# <!-- eidolon:gitignore start -->
# Managed by eidolons. Recreated by `eidolons sync`. Do not edit between markers.
/.eidolons/*
!/.eidolons/cortex/
!/.eidolons/cortex/**
!/.eidolons/harness/
!/.eidolons/harness/manifest.json
# <!-- eidolon:gitignore end -->

# Keep this ignore after Eidolons' managed exceptions above.
.eidolons/harness/manifest.json
